# =============================================================
# 研究・検証用 MySQL 8.4 設定
# 値を書き換えて `make restart` すると反映される。
# 変更前後で EXPLAIN やスロークエリログを比較する使い方を想定。
# =============================================================
[mysqld]

# ---- 文字コード ----
character-set-server = utf8mb4
# 日本語の照合順序を厳密に見たいときは utf8mb4_ja_0900_as_cs に変える
collation-server     = utf8mb4_0900_ai_ci

# ---- タイムゾーン ----
default-time-zone = '+09:00'

# ---- スロークエリログ ----
# ./logs/mysql/slow.log にホストから直接読める形で出力される
slow_query_log      = ON
slow_query_log_file = /var/log/mysql/slow.log
# 0.1秒以上のクエリを記録。全クエリを記録したいときは 0 にする
long_query_time     = 0.1
log_output          = FILE
# 実行時間だけでなく走査行数やロック時間も記録する(8.0.14以降)
log_slow_extra      = ON
# インデックスを使えていないクエリも記録する。
# ONにすると SHOW VARIABLES 等まで拾ってログが荒れるため既定はOFF。
# インデックスの効きを調べるときだけ `make noindex-on` で一時的に有効にする。
log_queries_not_using_indexes       = OFF
# 上記が大量に出るときの抑制。1分あたりこの件数までに絞る
log_throttle_queries_not_using_indexes = 10

# ---- 一般クエリログ ----
# 発行された全SQLを見たいときだけ ON にする(非常に重い)
general_log      = OFF
general_log_file = /var/log/mysql/general.log

# ---- エラーログ ----
log_error_verbosity = 2

# ---- performance_schema / sys スキーマ ----
# 待機イベントやクエリ統計の調査に使う
performance_schema = ON

# ---- InnoDB ----
# 検証用。バッファプールに載る/載らないの差を見たいときはここを増減させる
innodb_buffer_pool_size = 256M
innodb_redo_log_capacity = 128M
# 1=毎コミットfsync(既定/安全) 2や0にすると書き込みが速くなる代わりに耐障害性が下がる
innodb_flush_log_at_trx_commit = 1

# ---- 接続 ----
max_connections = 100

# ---- SQLモード(8.4の既定値を明示) ----
sql_mode = ONLY_FULL_GROUP_BY,STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

[mysql]
default-character-set = utf8mb4

[client]
default-character-set = utf8mb4
